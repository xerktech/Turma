{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama (Tenir-Ollama-Cue, RTX 6000 Pro)",
      "options": { "baseURL": "http://localhost:9402/v1" },
      "models": {
        "gpt-oss:120b": {
          "name": "gpt-oss 120b",
          "tool_call": true,
          "reasoning": true,
          "options": { "reasoningEffort": "medium" },
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "permission": { "edit": "allow", "bash": "allow", "webfetch": "deny" },
  "instructions": ["CLAUDE.md", "OPENCODE_CONTRACT.md"]
}
