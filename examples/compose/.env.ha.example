# Copy to .env.ha next to hub-ha.yaml and edit. Never commit the result.
#
#   cp .env.ha.example .env.ha
#   docker compose --env-file .env.ha -f hub-ha.yaml up -d
#
# This is the OPTIONAL local HA-testing stack (store + hub), NOT the default
# single-service deploy — that is hub.yaml / .env.example. Read hub-ha.yaml's
# header before running it; in particular a pre-HA hub image ignores every store
# var below.

# --- Hub auth (same as .env.example) ------------------------------------------
TURMA_USER=admin
TURMA_PASSWORD=change-me
# Generate with:  openssl rand -hex 32
TURMA_AGENT_TOKEN=change-me-too

# --- HA shared store ----------------------------------------------------------
# Credentials for the store containers this stack brings up. These are local
# test values — the store is reachable only on the compose network.
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=turma
MINIO_ROOT_PASSWORD=change-me-minio

# --- Optional overrides --------------------------------------------------------
# HA_MODE: 1 (default) forces HA on and the hub refuses to boot on any missing
# store URL; 0 runs the single-process file backend against these same
# containers. Leave unset to take the default.
# HA_MODE=1
#
# Point at an HA-capable build to actually exercise the store; the default
# :latest is only HA-capable once XERK-754 et al. ship.
# TURMA_IMAGE=ghcr.io/xerktech/turma:latest
