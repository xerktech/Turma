# Copy to .env next to hub.yaml and edit. Never commit the result.
#
#   cp .env.example .env
#
# This file configures the HUB only. Agents run NATIVELY on each host (systemd +
# a shipped tarball, see agent/native/README.md) and are configured in that
# host's own agent/native/turma-agent.env — not here.

# --- Hub auth -----------------------------------------------------------------
# The single operator login for the dashboard and its APIs. If TURMA_PASSWORD is
# empty the hub serves the whole UI unauthenticated and only warns about it.
TURMA_USER=admin
TURMA_PASSWORD=change-me

# The fleet MASTER agent credential, held by the hub alone. Each agent runs on
# its OWN token derived from this and its device name — print one on the hub with
#   node turma/server.js --agent-token "<device-name>"
# and set it as that host's TURMA_TOKEN in its turma-agent.env.
# Generate the master with:  openssl rand -hex 32
TURMA_AGENT_TOKEN=change-me-too

# Optional. Set once every agent runs on its own derived token: the master is
# then refused, so no agent can act as another host.
# TURMA_AGENT_STRICT=1

# Optional. Bearer token for POST /api/trigger, so CI or a webhook can start a
# session without the operator login.
# TURMA_TRIGGER_TOKEN=

# --- Optional integrations ----------------------------------------------------
# Whisper STT for glasses/Android dictation (hub). Any OpenAI-compatible /v1
# base; the hub derives /audio/transcriptions from it.
# LITELLM_URL=https://litellm.example.com/v1
# LITELLM_API_KEY=

# FCM push to the Android client (hub). Inline service-account JSON.
# FCM_SERVICE_ACCOUNT_JSON=
