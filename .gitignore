__pycache__/
*.pyc

# Local compose secrets — never commit. The `.env*` glob also catches the HA
# stack's `.env.ha`; the committed `*.example` templates are re-included below.
.env
.env.*
!.env.example
!.env.ha.example

# Ephemeral git worktrees created by Claude Code subagents running with
# `isolation: "worktree"`. They are real nested checkouts, so a `git add -A`
# stages them as embedded repositories. Nothing here is ever committed.
/.claude/worktrees/
